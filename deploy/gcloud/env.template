# =============================================================================
# LLM-Orchestrator Environment Configuration Template
# =============================================================================
# Copy this file to .env.{dev|staging|prod} and configure appropriately
# DO NOT commit actual values to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Service Identification
# -----------------------------------------------------------------------------
SERVICE_NAME=llm-orchestrator
SERVICE_VERSION=0.1.5
PLATFORM_ENV=dev  # dev | staging | prod

# -----------------------------------------------------------------------------
# Phase 3 - Automation & Resilience (Layer 1)
# -----------------------------------------------------------------------------
# REQUIRED: Agent phase and layer identification
AGENT_PHASE=phase3
AGENT_LAYER=layer1

# Performance Budgets (MANDATORY for Phase 3 Layer 1)
MAX_TOKENS=1500
MAX_LATENCY_MS=3000
MAX_CALLS_PER_RUN=4

# -----------------------------------------------------------------------------
# RuVector Service (Persistence Layer)
# -----------------------------------------------------------------------------
# REQUIRED: All persistence occurs via ruvector-service
# LLM-Orchestrator does NOT connect directly to Google SQL
RUVECTOR_SERVICE_URL=https://ruvector-service-${PLATFORM_ENV}.agentics.dev
RUVECTOR_API_KEY=<secret-manager-reference>

# -----------------------------------------------------------------------------
# Telemetry (LLM-Observatory)
# -----------------------------------------------------------------------------
TELEMETRY_ENDPOINT=https://observatory-${PLATFORM_ENV}.agentics.dev
TELEMETRY_ENABLED=true
TELEMETRY_SAMPLE_RATE=1.0

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
# Workflow Orchestrator Agent
WORKFLOW_MAX_CONCURRENCY=4
WORKFLOW_TIMEOUT_SECONDS=3600
WORKFLOW_MAX_RETRIES=3

# Task Scheduler Agent
SCHEDULER_DEFAULT_PRIORITY=50
SCHEDULER_MAX_DELAYED_MS=86400000

# Dependency Resolver Agent
DEPENDENCY_MAX_DEPTH=100
DEPENDENCY_MAX_PARALLEL=16

# Retry & Recovery Agent
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000
RETRY_BACKOFF_MULTIPLIER=2.0

# Parallelization Agent
PARALLEL_MAX_GROUP_SIZE=16
PARALLEL_RESOURCE_AWARE=true

# State Machine Agent
STATE_STRICT_VALIDATION=true
STATE_HISTORY_LIMIT=1000

# Swarm Coordinator Agent
SWARM_MAX_CONCURRENT_WORKERS=8
SWARM_WORKER_TIMEOUT_SECONDS=300

# -----------------------------------------------------------------------------
# Logging & Debugging
# -----------------------------------------------------------------------------
RUST_LOG=info,llm_orchestrator=debug
RUST_BACKTRACE=1

# -----------------------------------------------------------------------------
# HTTP Server
# -----------------------------------------------------------------------------
HTTP_PORT=8080
HTTP_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Downstream Services (for agent invocation)
# -----------------------------------------------------------------------------
# LLM-Edge-Agent (execution control)
LLM_EDGE_AGENT_URL=https://llm-edge-agent-${PLATFORM_ENV}.agentics.dev

# LLM-Shield (security enforcement)
LLM_SHIELD_URL=https://llm-shield-${PLATFORM_ENV}.agentics.dev

# LLM-Incident-Manager (incident workflows)
LLM_INCIDENT_MANAGER_URL=https://llm-incident-manager-${PLATFORM_ENV}.agentics.dev
